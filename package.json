{
  "name": "@elurjs/language-server",
  "version": "1.1.0",
  "description": "LSP server for Elur html`` tagged templates",
  "type": "module",
  "license": "MIT",
  "author": "Deiver Vasquez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elurjs/elur-language-server.git"
  },
  "bin": {
    "elur-language-server": "./bin/elur-language-server.js"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./browser": "./dist/server-browser.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "lsp",
    "language-server",
    "elur",
    "html",
    "tagged-template",
    "diagnostics",
    "completion"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-uri": "^3.0.8"
  },
  "peerDependencies": {
    "@elurjs/core": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@elurjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "^10.10.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}